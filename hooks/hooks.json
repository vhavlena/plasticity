{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLASTICITY_NO_BUILD=1 \"${CLAUDE_PLUGIN_ROOT}/bin/plasticity\" hook session-start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/plasticity\" hook setup",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLASTICITY_NO_BUILD=1 \"${CLAUDE_PLUGIN_ROOT}/bin/plasticity\" hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLASTICITY_NO_BUILD=1 \"${CLAUDE_PLUGIN_ROOT}/bin/plasticity\" hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PLASTICITY_NO_BUILD=1 \"${CLAUDE_PLUGIN_ROOT}/bin/plasticity\" hook session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
